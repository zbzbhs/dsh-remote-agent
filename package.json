{
  "name": "dsh-remote-agent",
  "version": "0.10.1-fork.12",
  "type": "module",
  "description": "\u628a\u53e6\u4e00\u53f0\u7535\u8111\u53d8\u6210\u4f60 DSH \u7684\u8fdc\u7a0b Agent \u540c\u4e8b\uff1a\u526f\u673a\u672c\u5730\u6301\u4e45\u8dd1\u4efb\u52a1\u3001\u72ec\u7acb Agent \u5faa\u73af\uff0c\u53ea\u56de\u4f20 handoff \u6458\u8981\u4e0e\u4ea7\u7269\u6e05\u5355\uff0c\u6210\u54c1\u6309\u9700\u62c9\u53d6\u3002",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zbzbhs/dsh-remote-agent.git"
  },
  "bugs": {
    "url": "https://github.com/zbzbhs/dsh-remote-agent/issues"
  },
  "homepage": "https://github.com/zbzbhs/dsh-remote-agent#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "ai-agent",
    "agent",
    "multi-agent",
    "remote-agent",
    "remote-execution",
    "task-automation",
    "self-hosted",
    "zero-dependency",
    "handoff",
    "artifact",
    "subagent-provider"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./hub": "./lib/hub/index.js",
    "./worker": "./lib/node/index.js",
    "./protocol": "./lib/protocol.js",
    "./pairing": "./lib/pairing.js",
    "./relay": "./lib/relay.js",
    "./setup": "./lib/setup.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./profiles/hub.cordis.yml": "./profiles/hub.cordis.yml",
    "./profiles/worker.cordis.yml": "./profiles/worker.cordis.yml"
  },
  "main": "./lib/index.js",
  "bin": {
    "dsh-remote-relay": "bin/dsh-remote-relay.js",
    "dsh-remote-setup": "bin/dsh-remote-setup.js"
  },
  "files": [
    "lib",
    "bin",
    "deploy",
    "docs",
    "profiles",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "KNOWN-ISSUES.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check:docs": "node scripts/check-doc-drift.mjs",
    "check:packaging": "node scripts/check-packaging.mjs",
    "lint": "eslint .",
    "check": "npm run check:packaging && npm run check:docs && npm run diag:inject && npm test",
    "diag:inject": "node scripts/diag-inject.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
